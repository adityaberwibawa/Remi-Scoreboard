# Contoh env — salin menjadi .env dan isi secret asli. Jangan commit .env.
PORT=3000
# Minimal 32 karakter acak. Contoh buat: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-minimal-32-karakter-acak-disini
DATABASE_PATH=pentungscore.db
# Asal frontend yang diizinkan, koma-dipisah. * hanya untuk dev lokal.
CORS_ORIGIN=*
