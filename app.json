{
  "expo": {
    "name": "PentungScore",
    "slug": "pentungscore",
    "version": "1.0.0",
    "scheme": "pentungscore",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "PentungScore memakai kamera untuk foto profil pemain.",
        "NSPhotoLibraryUsageDescription": "PentungScore memakai galeri untuk foto profil pemain.",
        "NSFaceIDUsageDescription": "PentungScore memakai Face ID agar hanya pemilik perangkat yang bisa membuka data permainan."
      }
    },
    "android": {
      "package": "com.nba.remiscoreboard",
      "adaptiveIcon": {
        "backgroundColor": "#101415",
        "foregroundImage": "./assets/icon.png"
      },
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101415",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "PentungScore memakai galeri untuk foto profil pemain.",
          "cameraPermission": "PentungScore memakai kamera untuk foto profil pemain."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "PentungScore memakai Face ID agar hanya pemilik perangkat yang bisa membuka data permainan."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "PentungScore memakai Face ID agar hanya pemilik perangkat yang bisa membuka data permainan."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3416c5f-f469-4b0a-a5ea-8cc524f1488f"
      }
    },
    "owner": "adityaberwibawa"
  }
}
