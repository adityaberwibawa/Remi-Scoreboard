# Proyek Supabase untuk Supabase Auth. Tanpa dua nilai ini fitur akun nonaktif
# (aplikasi tetap bisa dipakai mode lokal). Nilai ini aman ada di klien — kunci
# anon/publishable memang dirancang publik; jangan pernah memakai secret key di sini.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL backend opsional untuk sinkronisasi cloud.
EXPO_PUBLIC_API_URL=

# API key Google Maps SDK for Android. Wajib untuk build standalone/preview
# Android agar peta tidak kosong. iOS memakai Apple Maps sehingga tidak
# membutuhkan key ini. Set juga variabel ini di environment EAS Build.
GOOGLE_MAPS_API_KEY=
